<%- include('partials/head', { title: 'Partido en vivo'}) %> 

<div class="container-fluid py-4" style="font-family: 'Montserrat', sans-serif;">    
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-lg-8">
            <div class="card pantalla-partido shadow-sm border-0 p-4 text-center">
                <div class="text-uppercase text-muted small fw-bold mb-2">En Directo</div>
                
                <div class="d-flex align-items-center justify-content-center gap-4">
                    <div class="text-end" style="flex: 1;">
                        <h3 class="m-0 fw-bold d-inline-block align-middle me-3"><%= local.nombre %></h3>
                        <img src="/img/escudos/<%= local.escudo %>" alt="<%= local.nombre %>" class="escudo-marcador align-middle">
                    </div>

                    <div class="d-flex align-items-center gap-3 bg-dark px-4 py-2 rounded-4 border border-secondary">
                        <span id="golesLocal" class="numero-marcador text-success">0</span>
                        <div class="d-flex flex-column align-items-center px-2">
                            <span id="badgeMinuto" class="badge bg-danger badge-minuto shadow-sm">0'</span>
                            <small class="text-muted mt-1 fw-bold" id="estadoPartido">PAUSADO</small>
                        </div>
                        <span id="golesVisitante" class="numero-marcador text-primary">0</span>
                    </div>

                    <div class="text-start" style="flex: 1;">
                        <img src="/img/escudos/<%= visitante.escudo %>" alt="<%= visitante.nombre %>" class="escudo-marcador align-middle me-3">
                        <h3 class="m-0 fw-bold d-inline-block align-middle"><%= visitante.nombre %></h3>
                    </div>
                </div>

                <div class="consola-eventos rounded-3 mt-4 p-3 text-start text-success" id="cajaEventos">
                    <div class="text-muted">[0'] El árbitro hace sonar el silbato. ¡Arranca el partido!</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold d-flex align-items-center justify-content-between">
                    <span><%= local.nombre %></span>
                    <span class="badge bg-secondary"><%= local.tactica %></span>
                </div>
                <div class="list-group list-group-flush" id="listaTitularesLocal">
                    <% local.titulares.forEach((j, index) => { %>
                        <div class="list-group-item d-flex justify-content-between align-items-center jugador-item" data-id="<%= j._id %>">
                            <div>
                                <span class="text-muted small me-2"><%= index + 1 %></span>
                                <strong class="text-dark target-nombre-jugador"><%= j.nombre %></strong>
                                <span class="badge bg-light text-muted ms-1"><%= j.posicion %></span>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle"><%= j.forma %>%</span>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6 mb-4 order-last order-lg-0">
            <div class="card shadow-sm border-0 p-4 bg-white h-100">
                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2"><i class="bi bi-sliders me-2"></i>Panel del Entrenador</h5>
                
                <div class="d-flex gap-3 mb-4">
                    <button class="btn btn-success btn-lg flex-fill fw-bold shadow-sm" id="btnPlayPause">
                        <i class="bi bi-play-fill me-1"></i> REANUDAR
                    </button>
                    <button class="btn btn-outline-secondary btn-lg fw-bold" id="btnVelocidad">
                        <i class="bi bi-speedometer2 me-1"></i> x1
                    </button>
                </div>

                <ul class="nav nav-pills nav-fill mb-3" id="pills-tab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" id="tab-tactica" data-bs-toggle="pill" data-bs-target="#pills-tactica" type="button"><i class="bi bi-diagram-3 me-1"></i> Táctica</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" id="tab-cambios" data-bs-toggle="pill" data-bs-target="#pills-cambios" type="button"><i class="bi bi-people me-1"></i> Cambios</button>
                    </li>
                </ul>

                <div class="tab-content bg-light p-3 rounded-3 border border-light-subtle" id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-tactica" role="tabpanel">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Estilo de Juego</label>
                            <select class="form-select border-secondary-subtle" id="selectEstilo">
                                <option value="ESTÁNDAR" selected>Estándar</option>
                                <option value="TIKI-TAKA">Tiki-Taka (Posesión)</option>
                                <option value="CONTRAATAQUE">Contraataque</option>
                                <option value="AUTOBÚS">Autobús (Ultra Defensivo)</option>
                                <option value="BALÓN LARGO">Balón Largo</option>
                                <option value="PRESIÓN ALTA">Presión Alta</option>
                                <option value="JUEGO POR BANDAS">Juego por Bandas</option>
                                <option value="PONER CENTROS">Poner Centros</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold text-muted small">Mentalidad</label>
                            <select class="form-select border-secondary-subtle" id="selectMentalidad">
                                <option value="MUY_DEFENSIVA">Muy Defensiva</option>
                                <option value="DEFENSIVA">Defensiva</option>
                                <option value="EQUILIBRADA" selected>Equilibrada</option>
                                <option value="OFENSIVA">Ofensiva</option>
                                <option value="ULTRA_OFENSIVA">Ultra Ofensiva</option>
                            </select>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="pills-cambios" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="small fw-bold text-muted">Ventanas restantes: <span id="ventanasRestantes" class="text-dark fw-bold">3</span></span>
                            <span class="small fw-bold text-muted">Sustituciones: <span id="cambiosRestantes" class="text-dark fw-bold">0</span>/5</span>
                        </div>
                        
                        <div class="row g-2 mb-3">
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-bold text-muted">Sale (Titular):</label>
                                <select class="selectpicker form-control border" id="selectSaleTitular" data-live-search="true">
                                    <option value="" selected disabled>Selecciona titular...</option>
                                    <% local.titulares.forEach((j) => { %>
                                        <option value="<%= j._id %>"><%= j.nombre %> (<%= j.posicion %>)</option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="form-label small fw-bold text-muted">Entra (Suplente):</label>
                                <select class="selectpicker form-control border" id="selectEntraSuplente" data-live-search="true">
                                    <option value="" selected disabled>Selecciona suplente...</option>
                                    <% if (local.suplentes && local.suplentes.length > 0) { %>
                                        <% local.suplentes.forEach((j) => { %>
                                            <option value="<%= j._id %>" data-subtext="Forma: <%= j.forma %>%"><%= j.nombre %> (<%= j.posicion %>)</option>
                                        <% }) %>
                                    <% } else { %>
                                        <option disabled>No hay suplentes convocados</option>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <button class="btn btn-primary w-100 fw-bold shadow-sm py-2 disabled" id="btnConfirmarCambio">
                            <i class="bi bi-arrow-left-right me-1"></i> Solicitar Cambio
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-dark text-white fw-bold d-flex align-items-center justify-content-between">
                    <span><%= visitante.nombre %></span>
                    <span class="badge bg-secondary">IA</span>
                </div>
                <div class="list-group list-group-flush" id="listaTitularesVisitante">
                    <% visitante.titulares.forEach((j, index) => { %>
                        <div class="list-group-item d-flex justify-content-between align-items-center jugador-item">
                            <div>
                                <span class="text-muted small me-2"><%= index + 1 %></span>
                                <strong class="text-dark"><%= j.nombre %></strong>
                                <span class="badge bg-light text-muted ms-1"><%= j.posicion %></span>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle"><%= j.forma %>%</span>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        $('.selectpicker').selectpicker();

        // Pequeño validador visual para activar el botón de cambio solo si se seleccionan ambos jugadores
        $('#selectSaleTitular, #selectEntraSuplente').on('change', function() {
            const sale = $('#selectSaleTitular').val();
            const entra = $('#selectEntraSuplente').val();
            if(sale && entra) {
                $('#btnConfirmarCambio').removeClass('disabled');
            } else {
                $('#btnConfirmarCambio').addClass('disabled');
            }
        });
    });
</script>